<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>

	  <!-- Package identity -->
	  <PackageId>KozshTheMovieDbApi</PackageId>
	  <Version>1.0.1</Version>
	  <Authors>Kozsh</Authors>
	  <Description>Rest API Client for The Movie Database</Description>

	  <!-- Discovery -->
	  <PackageTags>kiota;api;client;tmdb</PackageTags>
	  <PackageProjectUrl>https://github.com/gatm50/kozshtmdbapi</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/gatm50/kozshtmdbapi</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>

	  <!-- Licensing -->
	  <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	  <!-- Or use PackageLicenseFile if needed -->

	  <!-- Optional quality-of-life -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
	  <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
	  <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
